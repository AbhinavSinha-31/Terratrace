**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.token
access_token
*service-account*.json
*-ee-key*.json
**/credentials.json
**/*credentials*.json
application_default_credentials.json
kaggle.json
**/kaggle.json
.kaggle/
.config/earthengine/

