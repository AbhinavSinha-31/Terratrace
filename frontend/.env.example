# TERRATRACE frontend configuration — copy to frontend/.env (or set these in Vercel → Project → Environment Variables).
# Every VITE_ variable is BAKED INTO THE PUBLIC BUNDLE: never put a secret here.

# ---- Backend API
# Default /api (proxied to http://localhost:8001 by `npm run dev`). In production: the backend's public URL ending in /api.
# VITE_API_BASE=https://api.example.com/api

# ---- Accounts (Supabase Auth + profiles) — optional; without them the app works and sign-in shows "not set up".
# Supabase dashboard → Project Settings → API (see docs/AUTH_SETUP.md).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…) or the legacy "anon" key. Safe in the browser: Row Level Security protects the
# data. NEVER the secret / service_role key — that one bypasses Row Level Security.
VITE_SUPABASE_PUBLISHABLE_KEY=
