# TERRATRACE frontend configuration — copy to frontend/.env.local (git-ignored), or set these in Vercel → Project → Environment Variables).
# Every VITE_ variable is BAKED INTO THE PUBLIC BUNDLE: never put a secret here.

# ---- Backend API
# Default /api (proxied to http://localhost:8001 by `npm run dev`). In production: the backend's public URL ending in /api.
# VITE_API_BASE=https://api.example.com/api
# …or just the backend's origin ("/api" is appended), e.g. the Render service (DEPLOY.md):
# VITE_API_URL=https://terratrace-api.onrender.com
# The site's public URL, for absolute link-preview (Open Graph) image URLs in production builds:
# VITE_SITE_URL=https://terratrace.vercel.app

# ---- Accounts (Supabase Auth + profiles) — optional; without them the app works and sign-in shows "not set up".
# Supabase dashboard → Project Settings → API (see docs/AUTH_SETUP.md).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon / publishable key (sb_publishable_… or the legacy "anon" JWT). Safe in the browser: Row Level Security protects
# the data. NEVER the secret / service_role key — that one bypasses Row Level Security.
# (VITE_SUPABASE_PUBLISHABLE_KEY is accepted as another name for the same key.)
VITE_SUPABASE_ANON_KEY=
# Show "Continue with Google" only after the Google provider is enabled in Supabase (docs/AUTH_SETUP.md).
VITE_AUTH_GOOGLE=false
