# TERRATRACE backend configuration — copy to backend/.env and fill in what you need.
# Never commit backend/.env. Nothing here is ever sent to the browser.

# ---- LIVE mode: Google Earth Engine -------------------------------------------------
# 1) A Google Cloud project registered for Earth Engine (noncommercial use is free):
#    https://code.earthengine.google.com/register  → note the project ID
# 2) EITHER a service-account key (recommended for demos) granted the
#    "Earth Engine Resource Viewer" role (and "Service Usage Consumer") on that project:
EE_PROJECT=
EE_SERVICE_ACCOUNT_KEY=            # absolute path to the JSON key file, e.g. C:\keys\terratrace-ee.json
#    OR run `earthengine authenticate` once (user credentials) and set only EE_PROJECT.
EE_TIMEOUT_S=120

# ---- AI explanations (optional — an offline deterministic briefing is always available)
ANTHROPIC_API_KEY=
TERRATRACE_LLM_MODEL=claude-opus-5
TERRATRACE_LLM_EFFORT=low

# ---- AI chat (POST /api/chat; off by default). Gemini API users must be 18+, and the FREE tier may not serve users in
#      the EEA, UK or Switzerland — see docs/PRE_DEPLOYMENT.md before enabling it anywhere public.
TT_CHAT_ENABLED=false
# Gemini API key: backend only; never in the frontend, never committed.
GEMINI_API_KEY=
TT_LLM_PROVIDER=gemini
TT_LLM_MODEL=gemini-3.8-flash
TT_LLM_FALLBACK_MODEL=gemini-3.5-flash-lite   # tried once when TT_LLM_MODEL answers 503 (overloaded); empty = no fallback
TT_CHAT_TIMEOUT_S=60
TT_LLM_THINKING=low                # minimal | low | medium | high | default ("minimal" is rejected by gemini-3.8-flash)
TT_LLM_MAX_OUTPUT_TOKENS=8192      # thinking tokens count against it
TT_CHAT_COOLDOWN_S=60              # after a Gemini 429, answer "busy" without calling Gemini for this long
TT_CHAT_STATS_ENABLED=false        # GET /api/chat/stats (no admin auth exists: local machines only)
# Conservative caps (Google publishes no fixed free-tier figures; read your project's limits in AI Studio):
TT_RATE_CHAT_PER_MIN=6             # per client
TT_CHAT_PER_CLIENT_PER_DAY=60
TT_CHAT_GLOBAL_PER_MIN=8           # whole backend
TT_CHAT_GLOBAL_PER_DAY=200         # whole backend, UTC day

# ---- Limits & services
TT_MAX_AOI_KM2=2500
TT_RATE_QUICKSCAN_PER_MIN=6        # "Run quick scan" starts per client (each is one Earth Engine request)
TT_RATE_TILES_PER_MIN=120          # map tiles fetched from Earth Engine (cache misses) per client; cached tiles are free
# TT_ANALYSIS_DIR=                 # where analysis/ lives if not next to backend/ (quick scan reuses its Landsat code)
TT_MIN_AOI_KM2=0.5
TT_GEOCODER=nominatim             # set to "off" to use the offline gazetteer only
TT_MAX_REQUEST_BYTES=1000000      # largest accepted request body

# ---- Production
# Exact browser origins allowed to call the API, comma-separated (localhost:5173 is always allowed).
# No wildcards — e.g. https://your-project.vercel.app
TT_CORS_ORIGINS=
# Durable state (areas, results, quick scans) — mount a PERSISTENT volume here. Default backend/.cache; /data in the image.
# TT_CACHE_DIR=
# Map tiles (disposable). Default: $TT_CACHE_DIR/tiles.
# TT_TILE_CACHE_DIR=
# Docker image only: proxy address(es) trusted for X-Forwarded-For (default *: the platform's proxy is the only way in).
# TT_FORWARDED_ALLOW_IPS=
# Must stay false in production (adds developer diagnostics to error responses).
DEV_DIAGNOSTICS=false

-