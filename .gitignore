Thumbs.db

# --- secrets & credentials (never commit)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
kaggle.json
**/kaggle.json
access_token
*.pem
*.key
*service-account*.json
*-ee-key*.json
**/credentials.json
**/*credentials*.json
application_default_credentials.json
*.p12
.kaggle/
.config/earthengine/
*.token

# --- ML data & model artefacts (datasets are downloaded locally, never committed)
ml/data/
ml/models/*.pt
ml/models/*.pth
ml/models/*.onnx
ml/models/*.ckpt
ml/models/*.safetensors
ml/models/*.pkl
ml/models/*.joblib
ml/outputs/

# --- LULC/UHI analysis pipeline: downloaded rasters and Earth Engine caches are regenerated by run_pipeline.py
analysis/outputs/cache/
# Rasters (GeoTIFF / NumPy) anywhere in analysis/ are regenerated and never committed; figures (PNG) and tables (CSV) are.
analysis/**/*.tif
analysis/**/*.tiff
analysis/**/*.npy

# --- TypeScript incremental build info
*.tsbuildinfo

# --- local audit reports (kept on disk, not versioned)
/TERRATRACE_PROJECT_AUDIT.md
/TERRATRACE_STATUS.md
/TERRATRACE_ARCHITECTURE.md

# local e2e builds
.e2e-dist/
